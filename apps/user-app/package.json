{
  "name": "@initia/user-app",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/dev/free-port.cjs 5173",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,scss,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@initia/core": "workspace:*",
    "@initia/shared": "workspace:*",
    "@initia/user-services": "workspace:*",
    "@initia/state": "workspace:*"
  }
}
